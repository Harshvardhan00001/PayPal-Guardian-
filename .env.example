# ==============================================================================
# PayPal Guardian - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://guardian_user:guardian_pass@localhost:5432/guardian_db?schema=public"

# AI Provider Configuration (Google Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# PayPal Sandbox Credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id_here
PAYPAL_MODE=sandbox

# Security & Shared Secrets
JWT_SECRET=super_secret_guardian_session_key_min32chars
AGENT_SHARED_SECRET=guardian_ai_agent_dev_token_456
